# =============================================================================
# aaa-analyzer — .env.analyzer 템플릿
# =============================================================================
#
# 이 파일은 analyzer 서비스 전용 환경 변수 템플릿이다.
# 프로덕션 배포 시 ${AAA_SSD_BASE}/secrets/.env.analyzer 로 복사하여 값을 채운다.
#
# 인프라 공통 변수(REDIS_HOST, REDIS_PORT, REDIS_APPUSER_PASSWORD, MYSQL_HOST,
# MYSQL_PORT, MYSQL_DATABASE 등)는 .env.common에서 제공되므로 이 파일에
# 포함하지 않는다. (ADR-006 참조)
#
# 보안:
#   chmod 600 ${AAA_SSD_BASE}/secrets/.env.analyzer
#
# =============================================================================


# -----------------------------------------------------------------------------
# Analyzer DB 계정 (런타임 SELECT + INSERT, SPEC-ANALYZER-SCHEMA-001)
# -----------------------------------------------------------------------------

# .env.mysql의 MYSQL_ANALYZER_PASSWORD와 반드시 동일한 값이어야 한다
MYSQL_ANALYZER_PASSWORD=<openssl rand -hex 24>


# -----------------------------------------------------------------------------
# Trainer DB 계정 (학습 파이프라인 전용 SELECT-only, SPEC-ANALYZER-TRAIN-001)
# -----------------------------------------------------------------------------

# .env.mysql의 MYSQL_TRAINER_PASSWORD와 반드시 동일한 값이어야 한다
# trainer 계정은 aaa.* 에 대해 SELECT 권한만 가지며 학습 파이프라인(train.py)에서만 소비한다
MYSQL_TRAINER_PASSWORD=<openssl rand -hex 24>


# -----------------------------------------------------------------------------
# 학습 원격 자동화 — WoL + SSH 디스패치 (SPEC-ANALYZER-TRAIN-AUTOMATION-001)
# -----------------------------------------------------------------------------
#
# analyzer(NAS 컨테이너)가 MacBook을 WoL로 기동하고 SSH로 TRAIN-001 학습
# 스크립트를 원격 디스패치하는 데 필요한 값. 18개 전부 필수(get_automation_config()
# — 하나라도 누락되면 MissingConfigError로 컨테이너 기동 시 즉시 실패). 이 중
# TRAIN_AUTOMATION_CONTAINER_MODELS_ROOT 1개는 SPEC-ANALYZER-TRAIN-STALENESS-001
# REQ-ATD-003이, TRAIN_AUTOMATION_MONTHLY_OPTUNA_STORAGE_DIR/
# TRAIN_AUTOMATION_MONTHLY_SUMMARY_REPORT_PATH 2개는
# SPEC-ANALYZER-TRAIN-TUNING-001 REQ-ATT-010/011이 신규 도입한 변수다(아래
# 별도 표기).
#
# ⚠️ SSH 프라이빗 키/known_hosts "파일 자체"는 여기 담지 않는다 — 그건 시크릿
# 값이 아니라 컨테이너 볼륨 마운트 대상이며 aaa-infra/docker-compose.yml +
# 실제 키 파일 배치가 별도로 필요하다(REQ-ATA-022). 아래는 그 파일들의
# "컨테이너 내부 경로"만 가리킨다.

# WoL 대상 MAC — 반드시 하드웨어(번인) MAC이어야 한다(`networksetup
# -listallhardwareports` 결과값). `ifconfig en0`가 보고하는 활성 인터페이스
# MAC(macOS Private Wi-Fi Address, 순환됨)을 쓰면 안 된다(plan.md §D, 2026-08-11 실측 근거)
TRAIN_AUTOMATION_TARGET_MAC=<xx:xx:xx:xx:xx:xx>

# NAS analyzer 컨테이너 → MacBook SSH 디스패치 연결 대상 — 사설 IP 또는 mDNS
# 호스트명 둘 중 하나(예: 192.0.2.10 또는 macbook-hostname.local, 둘을 이어붙이지 않는다)
TRAIN_AUTOMATION_SSH_HOST=<맥북 사설 IP 또는 mDNS 호스트명>
TRAIN_AUTOMATION_SSH_USERNAME=<맥북 원격 로그인 계정명>

# 디스패치 전용 SSH 키페어(신규 생성 필요, db_tunnel 키와 별개) — 컨테이너
# 내부 마운트 경로. 프라이빗 키는 mode 600 읽기전용 볼륨, known_hosts는 맥북
# SSH 호스트키 지문을 ssh-keyscan으로 채집해 핀 고정(REQ-ATA-022,
# StrictHostKeyChecking=no 금지)
TRAIN_AUTOMATION_SSH_KEY_PATH=/run/secrets/analyzer-dispatch-key
TRAIN_AUTOMATION_KNOWN_HOSTS_PATH=/run/secrets/analyzer-dispatch-known-hosts

# MacBook → NAS MySQL 접근 터널(db_tunnel 계정, 이미 라이브 프로비저닝된
# 기존 인프라 재사용 — REQ-ATA-093, 신규 프로비저닝 금지). DB_TUNNEL_HOST는
# 맥북에서 바라본 NAS 주소, DB_TUNNEL_KEY_PATH는 원격 명령 문자열에 그대로
# 삽입되는 "맥북상" 경로 문자열일 뿐이다 — 이 키 파일 자체는 NAS 컨테이너에
# 마운트할 필요가 없다(원격에서 실행되므로). aaa-infra/docs/TECHSPEC.md §6.2
# 문서화된 기존 `trainer-tunnel-datagrip`(Ed25519) 키 경로를 그대로 쓴다
# (예: 192.0.2.10)
TRAIN_AUTOMATION_DB_TUNNEL_HOST=<NAS 사설 IP>
TRAIN_AUTOMATION_DB_TUNNEL_KEY_PATH=<맥북상 trainer-tunnel-datagrip 프라이빗 키 경로>

# TRAIN-001 학습 파이프라인 경로(맥북상 경로, --models-root/--cache-dir로
# 원격 전달). STAGING은 사전 차단 설계의 임시 경로(plan.md §B.5 D6) — 학습
# 성공(SSH 종료코드 0) 후에만 ACTIVE로 병합된다. 원격 디스패치 명령이 학습
# CLI 실행 전 SMB 마운트(HDD_1)를 선행조건으로 확인하므로(아래
# MOUNT_SCRIPT_PATH), 두 경로 모두 마운트포인트 하위여야 한다
# (예: ~/Development/aaa/mnt/HDD_1/staging-models, .../active-models)
TRAIN_AUTOMATION_STAGING_MODELS_ROOT=<맥북 SMB 마운트포인트 하위 스테이징 모델 경로>
TRAIN_AUTOMATION_ACTIVE_MODELS_ROOT=<맥북 SMB 마운트포인트 하위 활성 모델 경로>

# SPEC-ANALYZER-TRAIN-STALENESS-001 REQ-ATD-003: 위 ACTIVE_MODELS_ROOT와
# "다른" 경로다 — ACTIVE_MODELS_ROOT는 맥북상 SMB 마운트 경로(원격 프로모션
# CLI가 소비)이고, 이 변수는 NAS analyzer 컨테이너 "내부" 마운트 경로다
# (aaa-infra docker-compose.yml의 active 모델 디렉토리 read-only bind mount
# 대상 — active만, staging은 마운트되지 않는다). 일일 정체 감지 잡
# (detect_stale_models())이 컨테이너 안에서 이 경로를 직접 rglob 스캔한다.
# 두 변수를 서로 대체하면 원격 프로모션 경로가 깨진다(재사용 금지).
TRAIN_AUTOMATION_CONTAINER_MODELS_ROOT=<NAS analyzer 컨테이너 내부 마운트 경로 (예: /mnt/models)>

TRAIN_AUTOMATION_CACHE_DIR=<맥북상 학습 데이터/피처 캐시 경로>

# SMB 무인 마운트 스크립트의 "맥북상" 경로(2026-08-12 실측 검증 완료).
# SSH_KEY_PATH/KNOWN_HOSTS_PATH와 동일 계열(계정별 절대경로)이라 기본값을 두지
# 않는다 — 계정이 다르면 컨테이너 기동 시점에 MissingConfigError로 즉시
# 드러나야 하며, 원격 SSH 실행 중 불명확한 셸 에러로 나타나서는 안 된다
TRAIN_AUTOMATION_MOUNT_SCRIPT_PATH=<맥북상 mount-nas-hdd1.sh 절대경로 (예: /Users/<계정명>/Development/aaa/scripts/mount-nas-hdd1.sh)>

# 맥북상 TRAIN-001 학습 venv의 python 절대경로. 원격 SSH 실행은 비대화형 셸이라
# .zshrc 등을 읽지 않아 PATH에 pyenv/uv venv가 안 잡힌다 — 시스템 `python`은
# 이 맥에 없고(`python3`만 존재), `python3`로 바꿔도 analyzer 패키지가 없는
# 시스템 파이썬이라 동일하게 실패한다(수동 실행 실측, 2026-08-13).
# SSH_KEY_PATH/MOUNT_SCRIPT_PATH와 동일 계열(계정별 절대경로)이라 기본값 없음
TRAIN_AUTOMATION_PYTHON_PATH=<맥북상 학습 venv python 절대경로 (예: /Users/<계정명>/Development/aaa/aaa-analyzer/.venv/bin/python)>

# SPEC-ANALYZER-TRAIN-OBSV-001: 트레이너 파일(trainer_<run_id>.log) 목적지
# 디렉토리 — 맥북상 SMB 마운트 지점 하위 절대경로. 원격 학습 CLI의
# stdout/stderr 전체(프레임워크 로그 포함)를 원문 그대로 영속 기록해 vector가
# 기존 analyzer_logs 소스로 자동 수집한다. SSH_KEY_PATH/MOUNT_SCRIPT_PATH/
# PYTHON_PATH와 동일 계열(계정별 절대경로)이라 기본값 없음 — analyzer 프로세스
# 자신은 aaa-infra 전용 셸 변수(AAA_HDD_BASE)를 읽지 않는다.
TRAIN_AUTOMATION_TRAINER_LOG_BASE_DIR=<맥북상 SMB 마운트 지점 하위 트레이너 로그 디렉토리 절대경로 (예: /Users/<계정명>/Development/aaa/mnt/HDD_1/Development/aaa/logs/aaa-analyzer)>

# SPEC-ANALYZER-TRAIN-TUNING-001 REQ-ATT-010: 월간 cron 재실행 전용 Optuna
# storage 디렉터리(맥북상 SMB 마운트 지점 하위 절대경로) — 수동/애드혹 캠페인
# 재실행이 사용하는 storage 디렉터리와 반드시 분리해야 한다(SQLite 파일 락
# 경합 회피). `create_or_resume_study()`가 load_if_exists=True로 재개하므로
# 월간 재실행 간 trial이 이 디렉터리 안에서 누적된다. 배포 전 NAS
# .env.analyzer에 선반영 필수 — 순서를 어기면 MissingConfigError 크래시루프
TRAIN_AUTOMATION_MONTHLY_OPTUNA_STORAGE_DIR=<맥북상 SMB 마운트 지점 하위 월간 전용 Optuna storage 디렉터리 절대경로 (예: /Users/<계정명>/Development/aaa/mnt/HDD_1/Development/aaa/optuna/monthly)>

# SPEC-ANALYZER-TRAIN-TUNING-001 REQ-ATT-011: 월간 캠페인 요약 리포트 출력
# 경로(맥북상 SMB 마운트 지점 하위 절대경로). 배포 전 NAS .env.analyzer에
# 선반영 필수 — 순서를 어기면 MissingConfigError 크래시루프
TRAIN_AUTOMATION_MONTHLY_SUMMARY_REPORT_PATH=<맥북상 SMB 마운트 지점 하위 월간 캠페인 요약 리포트 경로 (예: /Users/<계정명>/Development/aaa/mnt/HDD_1/Development/aaa/reports/monthly-campaign-summary.json)>

# 원격 학습 CLI(training/db.py get_trainer_db_config())가 요구하는 DB 접속
# 정보. 신규 시크릿이 아니라 이 컨테이너 자신의 MYSQL_DATABASE/
# MYSQL_TRAINER_PASSWORD(위 "Trainer DB 계정" 섹션)를 그대로 재사용해 원격
# 셸에 주입한다 — 비대화형 SSH 세션은 이 값들을 전혀 갖고 있지 않아 누락 시
# MissingConfigError로 즉시 실패한다(수동 실행 실측, 2026-08-13).
# MYSQL_HOST/MYSQL_PORT는 컨테이너 자신의 값이 아니라 db_tunnel 로컬
# 포워딩(127.0.0.1:DB_TUNNEL_LOCAL_PORT)으로 코드가 자동 고정하므로 별도
# env var가 필요 없다.

# 아래는 선택 항목 — 미설정 시 코드 기본값 사용(config.py 참고):
#   TRAIN_AUTOMATION_SSH_PORT(22) · TRAIN_AUTOMATION_DB_TUNNEL_USERNAME(db_tunnel)
#   TRAIN_AUTOMATION_DB_TUNNEL_SSH_PORT(22) — 터널 SSH 접속 자체의 포트(나스
#     sshd 포트). DB_TUNNEL_LOCAL_PORT/REMOTE_PORT(-L 포워딩의 MySQL 포트)와는
#     별개다 — 나스가 비표준 SSH 포트를 쓰면(aaa-infra/docs/TECHSPEC.md §6.2)
#     반드시 이 값을 설정해야 한다(Stage 2 실측 검증 중 발견, 2026-08-13)
#   TRAIN_AUTOMATION_DB_TUNNEL_LOCAL_PORT/REMOTE_PORT(3306)
#   TRAIN_AUTOMATION_WEEKLY_TIMEOUT_SECONDS(4시간) · TRAIN_AUTOMATION_MONTHLY_TIMEOUT_SECONDS(14시간, REQ-ATT-012)
#   TRAIN_AUTOMATION_STALENESS_THRESHOLD_DAYS(28) · TRAIN_AUTOMATION_CALENDAR_CODE(KRX)
#   TRAIN_AUTOMATION_FEATURE_CODE_VERSION(v1)


# -----------------------------------------------------------------------------
# 현재 스캐폴딩 단계 안내
# -----------------------------------------------------------------------------
#
# 실제 DB 연결 코드(SQLAlchemy 등)는 아직 구현되지 않았다 — 후속
# ANALYZER-INFER-001에서 추가 예정(REQ-ASCH-045). 이 파일은 docker-compose.yml
# analyzer 서비스의 env_file 전제 조건(REQ-ASCH-044 — 부재 시 컨테이너 기동
# 실패)을 충족하기 위해 먼저 배치한다.
